# --- CLI (npm run cli), personal access token — unchanged from v1 ---
CANVAS_API_URL=https://sua-instituicao.instructure.com/api/v1
CANVAS_API_TOKEN=

# --- Web app (npm run dev / build / start), Canvas OAuth2 Developer Key ---
CANVAS_DOMAIN=https://sua-instituicao.instructure.com
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=http://localhost/oauth2/callback
# Só é necessário se a Developer Key tiver "Enforce Scopes" habilitado; use os
# mesmos escopos habilitados na chave, separados por espaço.
CANVAS_OAUTH_SCOPES=

# --- Web app, criptografia da sessão ---
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# --- Geração de questões com IA (múltiplos provedores, src/lib/aiProviders) ---
# Todas opcionais — se vazias, cada adaptador usa seu próprio defaultModel.
# Não há *_API_KEY aqui: cada usuário cadastra sua própria chave por provedor
# em /perfil, guardada apenas na sessão (cookie criptografado), nunca como
# config compartilhada.
OPENAI_MODEL=
GEMINI_MODEL=
CLAUDE_MODEL=
